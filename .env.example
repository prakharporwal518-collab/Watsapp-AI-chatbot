# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit your real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# --- General ---------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production for structured logs
DEFAULT_TIMEZONE=Asia/Kolkata

# --- Database --------------------------------------------------------------
# Local dev: SQLite file. Production: PostgreSQL (postgres:// URLs are converted automatically).
DATABASE_URL=sqlite+aiosqlite:///./tutor.db
# DATABASE_URL=postgresql+asyncpg://tutor:tutor@localhost:5432/tutor
AUTO_CREATE_TABLES=true            # set false in production and run: alembic upgrade head
SEED_ON_STARTUP=true               # loads curriculum, quiz bank and problems (idempotent)

# Optional: needed when running more than one app instance (dedup + rate limits)
# REDIS_URL=redis://localhost:6379/0

# --- WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-long-random-string
WHATSAPP_APP_SECRET=               # App settings → Basic → App secret (used to verify webhook signatures)
WHATSAPP_API_VERSION=v21.0
# Approved template for reminders outside WhatsApp's 24-hour window (body with 2 params: {{1}} name, {{2}} text)
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
ALLOW_UNSIGNED_WEBHOOKS=false      # never true in production

# --- OpenAI (optional — without it the bot uses curated offline content) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                 # for OpenAI-compatible providers
LLM_DAILY_LIMIT_PER_USER=150

# --- Security & privacy ----------------------------------------------------
# Generate with:  python scripts/generate_secrets.py
DATA_ENCRYPTION_KEY=
IDENTIFIER_HASH_SECRET=
INTERNAL_API_TOKEN=
HISTORY_RETENTION_DAYS=30

# --- Behaviour -------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGE_CHARS=1500
MAX_CHUNKS_PER_REPLY=5
ENABLE_SCHEDULER=false             # true = send reminders from inside the app (single instance only)
DEV_CHAT_ENABLED=true              # /dev chat page for local testing (always off in production)
